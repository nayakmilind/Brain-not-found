# Local Compose development values only. Replace before using outside development.
POSTGRES_USER=privacy_shield
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=privacy_shield
API_PORT=8000
# Keep the password in DATABASE_URL synchronized and URL-encode special characters.
DATABASE_URL=postgresql+asyncpg://privacy_shield:replace-with-a-local-development-password@postgres:5432/privacy_shield
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
MASTER_KEK_B64=replace-with-base64-for-32-random-bytes
HMAC_PEPPER_B64=replace-with-a-different-base64-32-byte-secret
JWT_SECRET_B64=replace-with-another-base64-32-byte-secret
COOKIE_SECURE=false
SOURCE_MAX_BYTES=5242880
SOURCE_FETCH_TIMEOUT_SECONDS=10
SOURCE_MAX_REDIRECTS=3
EXTRACTION_MAX_CHARACTERS=2000000
EXTRACTION_MAX_PDF_PAGES=100
EXTRACTION_MAX_DOCX_UNCOMPRESSED_BYTES=20000000
# Optional: EMAIL_OTP ownership verification fails closed unless SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional OpenAI-compatible provider. Leave disabled for the local template fallback.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
